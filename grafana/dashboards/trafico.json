      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(10, sum by (service, route) (rate(http_requests_total{service=~\"$servicio\"}[5m])))",
